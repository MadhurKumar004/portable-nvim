#!/usr/bin/env bash
set -e
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
mkdir -p "$ROOT/bin" "$ROOT/data" "$ROOT/state" "$ROOT/cache"

if [ ! -x "$ROOT/bin/nvim" ]; then
  echo "Bootstrapping portable Neovim into $ROOT..."
  TMP="$(mktemp -d)"
  trap 'rm -rf "$TMP"' EXIT
  curl -fL --retry 3 "https://github.com/neovim/neovim-releases/releases/latest/download/nvim-linux-x86_64.tar.gz" -o "$TMP/nvim.tar.gz"
  tar -xzf "$TMP/nvim.tar.gz" -C "$ROOT" --strip-components=1
fi

if [ ! -x "$ROOT/bin/clangd" ]; then
  echo "Bootstrapping clangd 23.1.0 into $ROOT/bin..."
  TMP="$(mktemp -d)"
  trap 'rm -rf "$TMP"' EXIT
  curl -fL --retry 3 "https://github.com/clangd/clangd/releases/download/23.1.0/clangd-linux-23.1.0.zip" -o "$TMP/clangd.zip"
  python3 -m zipfile -e "$TMP/clangd.zip" "$TMP"
  cp "$TMP"/clangd_*/bin/clangd "$ROOT/bin/clangd"
  chmod 755 "$ROOT/bin/clangd"
fi

export XDG_CONFIG_HOME="$ROOT/config"
export XDG_DATA_HOME="$ROOT/data"
export XDG_STATE_HOME="$ROOT/state"
export XDG_CACHE_HOME="$ROOT/cache"
export PATH="$ROOT/bin:$PATH"
exec "$ROOT/bin/nvim" "$@"
